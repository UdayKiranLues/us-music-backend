# Test Environment Configuration
# Copy to .env.test in us-music-backend/

# MongoDB Test Database
MONGODB_URI=mongodb://localhost:27017/us-music-test
MONGODB_USER=
MONGODB_PASSWORD=

# Node Environment
NODE_ENV=test

# Server
PORT=3001
LISTEN_ADDRESS=127.0.0.1

# API Configuration
API_VERSION=v1
API_BASE_URL=http://localhost:3001

# Storage Configuration (use local for testing)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# AWS S3 (optional - can be empty for local testing)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test-key
AWS_SECRET_ACCESS_KEY=test-secret
AWS_S3_BUCKET=us-music-test-bucket

# JWT Configuration
JWT_SECRET=test-secret-key-for-testing-only
JWT_EXPIRE=7d

# Features
ENABLE_CDN=false
ENABLE_S3=false
ENABLE_STREAMING=true

# Logging
LOG_LEVEL=error
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
